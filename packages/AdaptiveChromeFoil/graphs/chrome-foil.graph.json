{
  "graphVersion": 1,
  "id": "chrome-foil",
  "inputs": [
    {
      "id": "coverage",
      "source": "TargetRegionCoverage",
      "type": "coverage",
      "availability": "required",
      "backgroundRequirement": "none",
      "space": "canvas",
      "capture": {
        "includeRuby": true,
        "includeStroke": true,
        "includeShadow": false,
        "includeGlow": false,
        "includeDescendantGroups": false,
        "includeOwnedOverlay": false,
        "region": "materialRegion"
      }
    }
  ],
  "parameters": [
    "liquidWarp",
    "metallicContrast",
    "sheenSpeed",
    "fallbackSkyColor",
    "fallbackGroundColor"
  ],
  "nodes": [
    {
      "id": "chrome",
