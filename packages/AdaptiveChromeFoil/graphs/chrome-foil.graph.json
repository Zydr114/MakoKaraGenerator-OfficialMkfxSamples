      "program": "shaders/chrome-foil.program.json",
      "children": {
        "coverage": "input:coverage"
      },
      "uniforms": {
        "timeSeconds": "host:timeSeconds",
        "liquidWarp": "parameter:liquidWarp",
        "metallicContrast": "parameter:metallicContrast",
