      "outputType": "color",
      "bounds": {
        "expandPx": 0,
        "maxExpandPx": 0,
        "maxSampleOffsetPx": 8
      },
      "edge": "transparent"
    }
  ],
  "output": "node:chrome",
  "anchorMode": "ColorOnly",
  "bounds": {
    "space": "canvas",
    "source": "targetRegion",
    "maxExpandPx": 0
  },
  "composite": {
    "mode": "sourceOver"
  }
