        "maxExpandPx": 0,
        "maxSampleOffsetPx": 0
      },
      "edge": "transparent"
    },
    {
      "id": "popGlow",
      "op": "Blur",
      "input": "node:sungOnly",
      "sigmaPx": 5.5,
      "bounds": {
        "expandPx": 18,
        "maxExpandPx": 18,
        "maxSampleOffsetPx": 18
      },
      "edge": "transparent"
    },
    {
      "id": "halftone",
      "op": "RuntimeShader",
      "program": "shaders/manga-halftone.program.json",
      "children": {
        "original": "input:original",
        "sung": "input:sung",
        "glyph": "input:glyph",
        "popGlow": "node:popGlow"
