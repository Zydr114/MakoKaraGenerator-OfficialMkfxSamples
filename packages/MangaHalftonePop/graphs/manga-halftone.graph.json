      "source": "SungCoverage",
      "type": "coverage",
      "availability": "required",
      "backgroundRequirement": "none",
      "space": "canvas",
      "capture": {
        "includeRuby": true,
        "includeStroke": false,
        "includeShadow": false,
        "includeGlow": false,
        "includeDescendantGroups": false,
        "includeOwnedOverlay": false,
        "region": "fill"
      }
    },
    {
      "id": "glyph",
      "source": "GlyphCoverage",
      "type": "coverage",
      "availability": "required",
      "backgroundRequirement": "none",
      "space": "canvas",
      "capture": {
        "includeRuby": true,
        "includeStroke": false,
        "includeShadow": false,
        "includeGlow": false,
        "includeDescendantGroups": false,
        "includeOwnedOverlay": false,
        "region": "fill"
      }
