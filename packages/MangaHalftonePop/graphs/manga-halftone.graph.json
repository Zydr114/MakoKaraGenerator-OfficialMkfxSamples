      "uniforms": {
        "timeSeconds": "host:timeSeconds",
        "dotPitchPx": "parameter:dotPitchPx",
        "misalignPx": "parameter:misalignPx",
        "inkColorA": "parameter:inkColorA",
        "inkColorB": "parameter:inkColorB",
        "shadowOffsetPx": "parameter:shadowOffsetPx",
        "halftoneContrast": "parameter:halftoneContrast"
      },
      "outputType": "color",
      "bounds": {
        "expandPx": 28,
        "maxExpandPx": 28,
        "maxSampleOffsetPx": 28
      },
      "edge": "transparent"
